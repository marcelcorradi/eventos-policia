# Chave da API da Anthropic (https://console.anthropic.com) — obrigatória
ANTHROPIC_API_KEY=

# Opcional: protege o app com um código. Se preenchido, o código precisa ser
# informado nas Configurações do app (ícone da cidade no topo).
ACCESS_CODE=

# Opcional: troca o modelo usado nas buscas (padrão: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5
